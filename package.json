{
    "name": "note-repetition",
    "version": "1.0.0",
    "description": "Review whole Obsidian notes with spaced or fixed-interval repetition.",
    "main": "main.js",
    "scripts": {
        "build": "tsc --noEmit && node esbuild.config.mjs production",
        "dev": "node esbuild.config.mjs",
        "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\"",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "test": "jest --config jest.config.js --coverage=false --runInBand",
        "check:version": "node scripts/check-version.mjs",
        "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm check:version"
    },
    "keywords": ["obsidian", "notes", "spaced repetition", "interval repetition"],
    "author": "Timon Wendland, based on obsidian-spaced-repetition by Stephen Mwangi and contributors",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.9.1",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "esbuild": "^0.28.1",
        "eslint": "^10.4.1",
        "jest": "^30.4.2",
        "moment": "^2.30.1",
        "obsidian": "^1.13.0",
        "prettier": "^3.8.3",
        "ts-jest": "^29.4.11",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.60.1"
    },
    "dependencies": {
        "minimatch": "^10.2.5"
    },
    "packageManager": "pnpm@11.6.0",
    "engines": {
        "pnpm": ">=11.6.0"
    }
}
