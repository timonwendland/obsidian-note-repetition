{
    "compilerOptions": {
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2018",
        "strict": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "types": ["node", "jest"],
        "lib": ["DOM", "DOM.Iterable", "ES2021"],
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/main.ts",
        "src/date-utils.ts",
        "src/interval.ts",
        "src/note-repetition-types.ts",
        "src/properties.ts",
        "src/review-manager.ts",
        "src/review-queue.ts",
        "src/review-queue-view.ts",
        "src/scheduler.ts",
        "src/settings.ts",
        "src/settings-tab.ts",
        "tests/note-repetition/**/*.ts"
    ],
    "exclude": ["build", "node_modules"]
}
